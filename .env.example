# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for links in emails and payment redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tap Payments (dashboard → goSell → API keys). Use sk_test_… until the account is approved.
TAP_SECRET_KEY=

# Order emails via Resend (resend.com). Leave empty to send nothing.
RESEND_API_KEY=
EMAIL_FROM="Hamilton Textiles <orders@example.com>"
# Where new-order alerts go
OWNER_EMAIL=

# Development only: simulate payments against a real Supabase database (ignored in production)
# DEMO_PAYMENTS=1
